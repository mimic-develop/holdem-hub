VITE_AUTH_PROVIDER=mimic

# Mock 강제 비활성화 — 로컬 .env.local의 VITE_MOCK=true가 빌드에 새는 것을 차단
# (.env.production은 .env.local보다 우선순위가 높다)
VITE_MOCK=false

# 운영 서버 — apiFetch + 인증 모두 이 URL 사용
VITE_MIMIC_API_URL=https://mimic.im/api
VITE_MIMIC_NUT_ENGINE_URL=https://mimic.im:48089
VITE_MIMIC_CLIENT_ID=mimic-web
# accessToken 자동 갱신 시 브라우저가 MIMIC에 직접 제시 (services/api의 MIMIC_CLIENT_SECRET과
# 동일 값 — GitHub Pages만 쓰고 백엔드를 두지 않기로 해 프론트 노출을 감수하기로 확정됨). 실제
# 배포 전 반드시 채워 넣을 것 — 비어있으면 갱신이 항상 실패한다.
VITE_MIMIC_CLIENT_SECRET=

# 통합 로그인 페이지 — 배포 도메인 확정되면 채움 (TBD)
VITE_UNIFIED_LOGIN_URL=https://mimic.im:48090

# PeerJS: 비워두면 peerjs 공개 브로커 사용 (heads-up 멀티플레이어)
VITE_PEERJS_HOST=
VITE_PEERJS_PORT=
VITE_PEERJS_PATH=
VITE_PEERJS_SECURE=true
VITE_PEERJS_KEY=
